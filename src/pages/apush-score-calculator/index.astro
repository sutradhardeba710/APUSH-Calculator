---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import DisclaimerCard from '../../components/common/DisclaimerCard.astro';
import SourceSection from '../../components/common/SourceSection.astro';
import RelatedTools from '../../components/common/RelatedTools.astro';
import JsonLd from '../../components/common/JsonLd.astro';

import CalculatorCard from '../../components/calculator/CalculatorCard.astro';
import ResultCard from '../../components/calculator/ResultCard.astro';
import ScoreScale from '../../components/calculator/ScoreScale.astro';
import ScoreBreakdown from '../../components/calculator/ScoreBreakdown.astro';
import PerformanceAnalysis from '../../components/calculator/PerformanceAnalysis.astro';
import WhatIfSimulator from '../../components/calculator/WhatIfSimulator.astro';
import TargetScoreCalculator from '../../components/calculator/TargetScoreCalculator.astro';
import ShareResult from '../../components/calculator/ShareResult.astro';
import MethodologySection from '../../components/calculator/MethodologySection.astro';
import FAQ from '../../components/faq/FAQ.astro';

import { getExamConfig } from '../../data/exam-config';
import { apushCalculatorFaqs } from '../../data/faq/apush-calculator';

const config = getExamConfig(2026);

const pageTitle = 'APUSH Score Calculator (2026–2027) | Accurate Composite & Curve Estimator';
const pageDescription = 'Calculate your AP U.S. History score with our free APUSH score calculator. Official College Board 40% MCQ, 20% SAQ, 25% DBQ, and 15% LEQ weighting with interactive curves.';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'APUSH Score Calculator',
  url: 'https://apushcalculator.com/apush-score-calculator/',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: pageDescription,
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://apushcalculator.com/apush-score-calculator/"
>
  <Header slot="header" activePath="/apush-score-calculator/" />

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <Breadcrumb items={[{ label: 'APUSH Score Calculator' }]} />

    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
        Calibrated for 2026 & 2027 Exam Formats
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-neutral-900 tracking-tight">
        AP U.S. History Score Calculator
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 mt-2 max-w-3xl leading-relaxed">
        Input your practice test scores to estimate your AP score (1–5). Formulated using official College Board weightings: 40% Multiple Choice, 20% Short Answer, 25% DBQ, and 15% Long Essay.
      </p>
    </div>

    <!-- Official Scoring Notice -->
    <DisclaimerCard className="mb-8" />

    <!-- Two-Column Calculator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Input Sections (5 cols / 48%) -->
      <div class="lg:col-span-6 xl:col-span-6 space-y-4">
        <CalculatorCard config={config} />
      </div>

      <!-- Right Column: Results & Analytics (6 cols / 52% sticky) -->
      <div class="lg:col-span-6 xl:col-span-6 space-y-6 lg:sticky lg:top-20">
        <ResultCard />
        <ScoreScale />
        <ScoreBreakdown />
        <ShareResult />
      </div>
    </div>

    <!-- Interactive Simulator Modules -->
    <WhatIfSimulator />
    <TargetScoreCalculator />
    <PerformanceAnalysis />

    <!-- Deep SEO Content & Methodology -->
    <MethodologySection />

    <!-- FAQ Accordion with Schema -->
    <FAQ items={apushCalculatorFaqs} />

    <!-- Official Sources & Verification -->
    <SourceSection />

    <!-- Cross-Linking Tools -->
    <RelatedTools currentPath="/apush-score-calculator/" />
  </div>

  <Footer slot="footer" />

  <JsonLd slot="head" schema={webAppSchema} />
</Layout>

<script>
  import { ApushCalculatorApp } from '../../scripts/calculator';

  document.addEventListener('DOMContentLoaded', () => {
    const app = new ApushCalculatorApp();
    app.init();
  });
</script>
