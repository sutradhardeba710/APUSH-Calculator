---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SourceSection from '../components/common/SourceSection.astro';
import FAQ from '../components/faq/FAQ.astro';
import { ALL_SUBJECTS } from '../data/exam-config/subjects-registry';

const pageTitle = 'ap score calculator – 2026 AP Exam Score Calculator Hub';
const pageDescription =
  'Use our free ap score calculator to calculate your AP exam scores for APUSH, AP Lang, AP Bio, and Calculus using official College Board weightings and curves.';


const homeFaqs = [
  {
    question: 'Is a 70% a 5 on the AP exam?',
    answer:
      'Yes, on many AP exams earning approximately 70% to 75% of the total composite points earns a score of 5. For instance, on AP U.S. History (APUSH), ~74 out of 100 composite points typically achieves a 5, while on AP Calculus BC, cutoffs around 60% to 65% regularly qualify for a 5. You do not need a 90% or higher to receive a 5.',
  },
  {
    question: 'What percentage is a 5 on APUSH?',
    answer:
      'Historically, a composite score of approximately 74 out of 100 (~74%) is required to earn a 5 on the APUSH exam. Because sections are weighted differently, you do not need 74% on every single section. For example, earning 42/55 on Multiple-Choice, 6/9 on Short Answers, 5/7 on the DBQ, and 5/6 on the LEQ yields 74.2 composite points, qualifying for a 5.',
  },
  {
    question: 'How is AP score calculated?',
    answer:
      'AP scores are calculated by converting raw points earned on multiple-choice questions (Section I) and free-response questions (Section II) into a weighted composite score using official College Board percentages. Psychometric equating then translates that composite into the final 1 to 5 score.',
  },
  {
    question: 'How do I figure out my AP score?',
    answer:
      'To figure out your AP score from a practice test, score your multiple-choice questions (1 point each with no penalty for wrong answers), evaluate your free-response essays against official scoring rubrics, apply your subject’s specific section multipliers to find your composite, and check against published equating tables.',
  },
  {
    question: 'How to calculate APUSH score?',
    answer:
      'To calculate your APUSH score, multiply your raw MCQ score (0–55) by 0.7273, your SAQ score (0–9) by 2.2222, your DBQ score (0–7) by 3.5714, and your LEQ score (0–6) by 2.5000. Summing all four weighted sections gives your composite score out of 100, which maps to: 74–100 = 5, 60–73 = 4, 47–59 = 3, 35–46 = 2, and 0–34 = 1.',
  },
  {
    question: 'Are AP score calculators accurate?',
    answer:
      'Yes. Our calculators use the exact section weights and question counts from official College Board Course and Exam Descriptions (CED), combined with historical score cutoffs released from recent exams. While specific equating curves vary slightly each year, our estimates typically fall within ±2 to 2.5 composite points.',
  },
  {
    question: 'What is the APUSH curve and score conversion chart for 2026?',
    answer:
      'The 2026 APUSH exam uses psychometric equating rather than a fixed grading curve. Historical composite score thresholds are: Score 5: 74–100 points (~10.5%–13% of students), Score 4: 60–73 points (~15%–16%), Score 3: 47–59 points (~22%–24%), Score 2: 35–46 points (~23%–25%), and Score 1: 0–34 points (~24%–28%).',
  },
  {
    question: 'How does this tool compare to Albert.io, Knowt, or Fiveable?',
    answer:
      'Unlike commercial platforms like Albert.io, Knowt, or Fiveable, our calculators are 100% free with no account creation or login required. All calculations run instantly in your browser with zero latency and full privacy, complete with interactive "What-If" score simulators and granular rubric breakdowns.',
  },
  {
    question: 'What subjects are supported on the AP Score Calculator Hub?',
    answer:
      'We support dedicated calculators for AP U.S. History (APUSH), AP English Language and Composition (AP Lang), AP Biology, AP Calculus AB, AP Calculus BC, AP Psychology, AP Chemistry, and AP Computer Science Principles (AP CSP).',
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://apushcalculator.com/"
>
  <Header slot="header" activePath="/" />

  <!-- Hero Section -->
  <section class="bg-white border-b border-neutral-200 pt-10 pb-14 sm:pt-16 sm:pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-5">
        <p class="text-xs font-semibold text-neutral-500 uppercase tracking-widest">
          2026 &amp; 2027 College Board Standards
        </p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black font-heading text-neutral-900 tracking-tight leading-tight">
          AP® Score Calculator Hub
        </h1>

        <p class="text-base sm:text-lg text-neutral-600 max-w-2xl mx-auto leading-relaxed">
          Estimate your AP exam scores from practice test results using our free ap score calculator with official College Board weightings, interactive what-if simulators, and historical curves.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-3 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/ap-score-calculators/"
            class="btn-tactile group px-6 py-3 rounded-lg font-bold text-sm text-white bg-blue-700 hover:bg-blue-800 shadow-sm hover:shadow-md transition-all duration-150 focus-visible:outline-2 focus-visible:outline-blue-600 flex items-center gap-2"
          >
            <span>Explore All 8 Calculators</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-150" aria-hidden="true">→</span>
          </a>
          <a
            href="/apush-score-calculator/"
            class="btn-tactile px-6 py-3 rounded-lg font-bold text-sm text-neutral-700 bg-white hover:bg-neutral-50 border border-neutral-300 shadow-sm transition-all duration-150"
          >
            apush score calculator free
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Body Content -->
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    <!-- 8 Subject Calculators Grid -->
    <section class="reveal-on-scroll">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-neutral-900 tracking-tight">
          Select Your AP Exam
        </h2>
        <p class="text-sm text-neutral-500">
          Each calculator uses subject-specific scoring rules, official exam structures, and historical distributions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          ALL_SUBJECTS.map((sub) => (
            <a
              href={`/${sub.slug}/`}
              class="interactive-card group relative p-6 rounded-xl bg-white border border-neutral-200 hover:border-blue-400 flex flex-col justify-between"
            >
              <div class="space-y-3">
                <!-- Category & Abbreviation -->
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider truncate">
                    {sub.category}
                  </span>
                  <span class="px-2 py-0.5 rounded text-[11px] font-bold font-mono text-blue-700 bg-blue-50 border border-blue-100 shrink-0">
                    {sub.abbreviation}
                  </span>
                </div>

                <!-- Title & Description -->
                <div>
                  <h3 class="text-base font-bold font-heading text-neutral-900 group-hover:text-blue-700 transition-colors duration-150 leading-snug">
                    {sub.name}
                  </h3>
                  <p class="text-xs text-neutral-500 mt-1.5 leading-relaxed line-clamp-2">
                    {sub.shortDescription}
                  </p>
                </div>

                <!-- Specs Line -->
                <div class="pt-3 border-t border-neutral-100 text-[11px] text-neutral-400 font-medium tabular-nums">
                  {sub.examYears[sub.defaultYear].sections.length} sections · {sub.examYears[sub.defaultYear].totalCompositeMax} pts max
                </div>
              </div>

              <!-- Action Footer -->
              <div class="pt-4 mt-4 border-t border-neutral-100 flex items-center gap-1.5 text-xs font-bold text-neutral-700 group-hover:text-blue-700 transition-colors">
                <span>Calculate Score</span>
                <span class="group-hover:translate-x-0.5 transition-transform duration-150" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-8 text-center">
        <a
          href="/ap-score-calculators/"
          class="group inline-flex items-center gap-1.5 text-sm font-bold text-blue-700 hover:underline"
        >
          <span>Browse the complete AP Score Calculator Hub directory</span>
          <span class="group-hover:translate-x-1 transition-transform duration-150" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- APUSH Deep-Dive Cluster Section -->
    <section class="reveal-on-scroll p-8 sm:p-10 rounded-2xl bg-neutral-50 border border-neutral-200 space-y-6">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold font-heading text-neutral-900">
          Specialized APUSH Rubric Tools
        </h2>
        <p class="text-sm text-neutral-500 mt-1">
          In addition to the composite calculator, master specific APUSH essay rubrics and curve analysis with our dedicated tools.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a
          href="/apush-dbq-score-calculator/"
          class="interactive-card group p-5 rounded-xl bg-white border border-neutral-200 hover:border-blue-400 space-y-2"
        >
          <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">7-Point Rubric</span>
          <h3 class="text-sm font-bold text-neutral-900 group-hover:text-blue-700 transition-colors">APUSH DBQ Rubric Calculator</h3>
          <p class="text-xs text-neutral-500">Calculate thesis, context, document citations, and HIPP sourcing.</p>
        </a>

        <a
          href="/apush-leq-score-calculator/"
          class="interactive-card group p-5 rounded-xl bg-white border border-neutral-200 hover:border-blue-400 space-y-2"
        >
          <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">6-Point Rubric</span>
          <h3 class="text-sm font-bold text-neutral-900 group-hover:text-blue-700 transition-colors">APUSH LEQ Rubric Calculator</h3>
          <p class="text-xs text-neutral-500">Master thesis, context, historical evidence, and complex reasoning.</p>
        </a>

        <a
          href="/apush-score-predictor/"
          class="interactive-card group p-5 rounded-xl bg-white border border-neutral-200 hover:border-blue-400 space-y-2"
        >
          <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Score Predictor</span>
          <h3 class="text-sm font-bold text-neutral-900 group-hover:text-blue-700 transition-colors">APUSH Score Predictor</h3>
          <p class="text-xs text-neutral-500">Analyze your statistical probabilities of scoring 3, 4, or 5.</p>
        </a>
      </div>
    </section>

    <!-- Platform Features -->
    <section class="reveal-on-scroll grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-xl bg-white border border-neutral-200 space-y-2.5">
        <div class="w-9 h-9 rounded-lg bg-neutral-100 text-neutral-800 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold font-heading text-neutral-900">Instant Local Calculations</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Zero server delay. Composite scores, section breakdowns, and percentiles calculate instantly in your browser as you type or adjust sliders.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-white border border-neutral-200 space-y-2.5">
        <div class="w-9 h-9 rounded-lg bg-neutral-100 text-neutral-800 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold font-heading text-neutral-900">Official College Board Weights</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Calibrated directly from official Course and Exam Descriptions (CED). Every subject honors exact question counts, time limits, and rubric weightings.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-white border border-neutral-200 space-y-2.5">
        <div class="w-9 h-9 rounded-lg bg-neutral-100 text-neutral-800 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold font-heading text-neutral-900">What-If & Target Score Tools</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Simulate how gaining 1 or 2 more points on a specific essay or multiple-choice section impacts your score, optimizing your study strategy.
        </p>
      </div>
    </section>

    <!-- Scoring Methodology Section -->
    <section class="reveal-on-scroll p-8 sm:p-10 rounded-2xl bg-white border border-neutral-200 space-y-4">
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-neutral-900 tracking-tight">
          how to calculate ap score with official weights
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 mt-2 leading-relaxed">
          Wondering how are ap scores calculated across different exams? Each official AP exam uses dedicated section multipliers specified in the Course and Exam Description (CED). Raw multiple-choice scores and free-response rubric points are multiplied and summed into a standardized composite, which psychometricians then map to the 1–5 AP scale using equating thresholds.
        </p>
      </div>
    </section>

    <!-- FAQ Accordion with Schema -->
    <FAQ items={homeFaqs} />
  </main>

  <Footer slot="footer" />
</Layout>
