---
import type { FaqItem } from '../../data/faq/apush-calculator';

interface Props {
  items: FaqItem[];
  title?: string;
  description?: string;
}

const {
  items,
  title = 'Frequently Asked Questions',
  description = 'Clear answers regarding APUSH scoring formulas, composite cutoffs, and curves.',
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="mt-16 pt-10 border-t border-neutral-200">
  <div class="max-w-3xl">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold font-heading text-neutral-900">{title}</h2>
      <p class="text-sm text-neutral-500 mt-1">{description}</p>
    </div>

    <div class="space-y-3 faq-accordion-group">
      {
        items.map((item) => (
          <details class="faq-details group rounded-xl border border-neutral-200 bg-white overflow-hidden transition-colors duration-150 open:border-neutral-300">
            <summary class="faq-summary flex items-center justify-between p-4 sm:p-5 cursor-pointer list-none select-none font-heading font-semibold text-neutral-900 hover:text-blue-700 transition-colors focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-[-2px]">
              <span class="text-sm sm:text-base pr-4">{item.question}</span>
              <span class="faq-icon-wrapper shrink-0 w-8 h-8 rounded-lg bg-neutral-50 flex items-center justify-center transition-all duration-200 group-open:bg-blue-50 group-open:rotate-180 text-neutral-500 group-open:text-blue-700">
                <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </summary>
            <div class="faq-content overflow-hidden">
              <div class="px-4 pb-5 pt-1 sm:px-5 sm:pb-6 text-xs sm:text-sm text-neutral-600 leading-relaxed border-t border-neutral-100/80">
                <p>{item.answer}</p>
                {item.category && (
                  <span class="inline-block mt-3 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-neutral-100 text-neutral-600">
                    {item.category}
                  </span>
                )}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  function setupAnimatedFaq() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const detailsElements = document.querySelectorAll<HTMLDetailsElement>('.faq-details');

    detailsElements.forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.faq-summary');
      const content = details.querySelector<HTMLElement>('.faq-content');
      if (!summary || !content) return;

      let isAnimating = false;

      summary.addEventListener('click', (e) => {
        if (prefersReducedMotion) return; // let browser handle it natively

        e.preventDefault();
        if (isAnimating) return;

        if (details.open) {
          // Closing animation
          isAnimating = true;
          const startHeight = content.offsetHeight;
          content.style.height = `${startHeight}px`;
          content.style.transition = 'height 220ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease';
          content.style.opacity = '1';

          requestAnimationFrame(() => {
            content.style.height = '0px';
            content.style.opacity = '0';
          });

          const onTransitionEnd = () => {
            content.removeEventListener('transitionend', onTransitionEnd);
            details.open = false;
            content.style.height = '';
            content.style.opacity = '';
            content.style.transition = '';
            isAnimating = false;
          };
          content.addEventListener('transitionend', onTransitionEnd);
        } else {
          // Opening animation
          details.open = true;
          isAnimating = true;
          const targetHeight = content.scrollHeight;
          content.style.height = '0px';
          content.style.opacity = '0';
          content.style.transition = 'height 250ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease';

          requestAnimationFrame(() => {
            content.style.height = `${targetHeight}px`;
            content.style.opacity = '1';
          });

          const onTransitionEnd = () => {
            content.removeEventListener('transitionend', onTransitionEnd);
            content.style.height = '';
            content.style.opacity = '';
            content.style.transition = '';
            isAnimating = false;
          };
          content.addEventListener('transitionend', onTransitionEnd);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAnimatedFaq);
  } else {
    setupAnimatedFaq();
  }
</script>
