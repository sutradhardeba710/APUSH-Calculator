---
import type { FaqItem } from '../../data/faq/apush-calculator';

interface Props {
  items: FaqItem[];
  title?: string;
  description?: string;
}

const {
  items,
  title = 'Frequently Asked Questions',
  description = 'Clear answers regarding APUSH scoring formulas, composite cutoffs, and curves.',
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="mt-16 pt-10 border-t border-neutral-200">
  <div class="max-w-3xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold font-heading text-neutral-900">{title}</h2>
      <p class="text-sm text-neutral-600 mt-1">{description}</p>
    </div>

    <div class="space-y-3">
      {
        items.map((item, index) => (
          <details class="group rounded-xl border border-neutral-200/90 bg-white shadow-2xs overflow-hidden transition-all duration-200">
            <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer list-none select-none font-heading font-semibold text-neutral-900 hover:text-blue-700 transition-colors">
              <span class="text-sm sm:text-base pr-4">{item.question}</span>
              <span class="shrink-0 transition-transform duration-200 group-open:rotate-180 text-neutral-500 group-hover:text-blue-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </summary>
            <div class="px-4 pb-5 pt-1 sm:px-5 sm:pb-6 text-xs sm:text-sm text-neutral-600 leading-relaxed border-t border-neutral-100">
              <p>{item.answer}</p>
              {item.category && (
                <span class="inline-block mt-3 px-2 py-0.5 rounded text-[10px] font-semibold bg-neutral-100 text-neutral-600">
                  {item.category}
                </span>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
