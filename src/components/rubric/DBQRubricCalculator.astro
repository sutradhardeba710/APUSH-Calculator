---
import { dbqRubric } from '../../data/rubrics/dbq';
---

<div id="dbq-calculator-container" class="space-y-6">
  <!-- Dynamic Summary Bar -->
  <div class="sticky top-18 z-30 p-4 rounded-xl bg-white border border-neutral-200/90 shadow-md flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Total DBQ Score</span>
        <span class="text-2xl sm:text-3xl font-heading font-black text-neutral-900">
          <span id="dbq-total-score">5</span> <span class="text-neutral-400 text-base font-normal">/ 7</span>
        </span>
      </div>
      <div class="h-8 w-px bg-neutral-200 hidden sm:block"></div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Exam Contribution</span>
        <span class="text-lg sm:text-xl font-heading font-extrabold text-blue-700">
          <span id="dbq-composite-points">17.86</span> <span class="text-xs font-medium text-neutral-500">/ 25.0 composite pts</span>
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        id="apply-dbq-to-main"
        href="/apush-score-calculator/?dbq=5"
        class="px-3.5 py-2 text-xs font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-lg shadow-xs transition-colors"
      >
        Send to Full Calculator →
      </a>
    </div>
  </div>

  <!-- Rubric Criteria Cards -->
  <div class="space-y-5">
    {
      dbqRubric.map((criteria, index) => (
        <div class="p-5 rounded-xl bg-white border border-neutral-200/90 shadow-xs dbq-criteria-card" data-criteria-id={criteria.id}>
          <div class="flex items-start justify-between gap-3 mb-2">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded">
                {criteria.category} · Max {criteria.maxPoints} pt{criteria.maxPoints > 1 ? 's' : ''}
              </span>
              <h3 class="text-base font-bold font-heading text-neutral-900 mt-1">
                {index + 1}. {criteria.name}
              </h3>
            </div>
            <span class="criteria-selected-pts text-sm font-bold font-mono text-neutral-900 bg-neutral-100 px-2.5 py-1 rounded-md">
              {criteria.options[criteria.options.length - 1].points} pt
            </span>
          </div>

          <p class="text-xs text-neutral-600 mb-4 leading-relaxed">
            {criteria.description}
          </p>

          <!-- Radio Option Pills -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
            {
              criteria.options.map((option, optIdx) => {
                const isDefault = optIdx === criteria.options.length - 1; // default to max
                return (
                  <label class={`rubric-option-label relative flex flex-col p-3 rounded-lg border cursor-pointer transition-all ${
                    isDefault ? 'border-blue-600 bg-blue-50/40' : 'border-neutral-200 hover:bg-neutral-50'
                  }`}>
                    <div class="flex items-center justify-between mb-1">
                      <span class="text-xs font-bold text-neutral-900">{option.label}</span>
                      <input
                        type="radio"
                        name={criteria.id}
                        value={option.points}
                        checked={isDefault}
                        class="accent-blue-700 dbq-rubric-radio"
                      />
                    </div>
                    <p class="text-[11px] text-neutral-600 leading-snug">{option.requirement}</p>
                    <div class="mt-2 pt-1.5 border-t border-neutral-200/60 text-[10px] text-blue-800 font-medium">
                      💡 {option.tips}
                    </div>
                  </label>
                );
              })
            }
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  function updateDbqRubric() {
    const radioGroups = document.querySelectorAll('.dbq-rubric-radio:checked') as NodeListOf<HTMLInputElement>;
    let total = 0;
    radioGroups.forEach((radio) => {
      total += parseInt(radio.value, 10) || 0;
    });

    const scoreDisplay = document.getElementById('dbq-total-score');
    const compositeDisplay = document.getElementById('dbq-composite-points');
    const applyLink = document.getElementById('apply-dbq-to-main') as HTMLAnchorElement;

    if (scoreDisplay) scoreDisplay.textContent = total.toString();
    if (compositeDisplay) compositeDisplay.textContent = ((total / 7) * 25).toFixed(2);
    if (applyLink) applyLink.href = `/apush-score-calculator/?dbq=${total}`;

    // Highlight active labels
    document.querySelectorAll('.rubric-option-label').forEach((label) => {
      const input = label.querySelector('input[type="radio"]') as HTMLInputElement;
      if (input && input.checked) {
        label.classList.add('border-blue-600', 'bg-blue-50/40');
        label.classList.remove('border-neutral-200');
      } else {
        label.classList.remove('border-blue-600', 'bg-blue-50/40');
        label.classList.add('border-neutral-200');
      }
    });

    // Update criteria badge points
    document.querySelectorAll('.dbq-criteria-card').forEach((card) => {
      const checked = card.querySelector('input[type="radio"]:checked') as HTMLInputElement;
      const badge = card.querySelector('.criteria-selected-pts');
      if (checked && badge) {
        badge.textContent = `${checked.value} pt${checked.value === '1' ? '' : 's'}`;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.dbq-rubric-radio').forEach((radio) => {
      radio.addEventListener('change', updateDbqRubric);
    });
    updateDbqRubric();
  });
</script>
