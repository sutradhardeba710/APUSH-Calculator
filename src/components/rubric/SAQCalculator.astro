---
import { saqConfig } from '../../data/rubrics/saq';
---

<div id="saq-calculator-container" class="space-y-6">
  <!-- Dynamic Summary Bar -->
  <div class="sticky top-18 z-30 p-4 sm:p-5 rounded-xl bg-white/95 backdrop-blur-md border border-neutral-200 shadow-sm flex flex-wrap items-center justify-between gap-4 transition-all">
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-semibold text-neutral-400 tracking-wider">Total SAQ Score</span>
        <span class="text-2xl sm:text-3xl font-heading font-black text-neutral-900 tabular-nums">
          <span id="saq-total-score">6</span> <span class="text-neutral-400 text-base font-normal">/ 9</span>
        </span>
      </div>
      <div class="h-8 w-px bg-neutral-200 hidden sm:block"></div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-semibold text-neutral-400 tracking-wider">Exam Contribution</span>
        <span class="text-lg sm:text-xl font-heading font-extrabold text-blue-700 tabular-nums">
          <span id="saq-composite-points">13.33</span> <span class="text-xs font-medium text-neutral-500">/ 20.0 composite pts</span>
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        id="apply-saq-to-main"
        href="/apush-score-calculator/?saq=6"
        class="btn-tactile px-4 py-2 text-xs font-bold text-white bg-blue-700 hover:bg-blue-800 rounded-lg shadow-sm hover:shadow transition-all duration-150 flex items-center gap-1.5"
      >
        <span>Send to Full Calculator</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- ACE Formula Banner -->
  <div class="p-4 sm:p-5 rounded-xl bg-neutral-50 border border-neutral-200 text-xs text-neutral-800 flex items-start gap-3">
    <span class="px-2 py-0.5 rounded bg-blue-700 text-white font-bold text-xs shrink-0 mt-0.5">ACE</span>
    <div>
      <h4 class="font-bold text-neutral-900 mb-0.5 text-sm">The SAQ Response Formula:</h4>
      <p class="text-neutral-600 leading-relaxed">
        <strong>A</strong>nswer the prompt directly with a clear historical claim · 
        <strong>C</strong>ite specific evidence (proper noun, legislation, individual, or event) · 
        <strong>E</strong>xplain how that evidence supports your claim. Aim for 2–3 precise sentences per subpart.
      </p>
    </div>
  </div>

  <!-- SAQ Questions Grid -->
  <div class="space-y-6">
    {
      saqConfig.map((q) => (
        <div class="p-5 sm:p-6 rounded-xl bg-white border border-neutral-200 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-neutral-100">
            <div>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">
                {q.type} · {q.periodsCovered}
              </span>
              <h3 class="text-base font-bold font-heading text-neutral-900 mt-1.5">{q.title}</h3>
              <p class="text-xs text-neutral-500">{q.stimulusType}</p>
            </div>
            <span class="text-xs font-bold font-mono text-neutral-700 bg-neutral-100 px-2.5 py-1 rounded-lg tabular-nums">
              <span class="q-score-sum font-extrabold text-neutral-900" data-q-id={q.id}>2</span> / 3 pts
            </span>
          </div>

          <!-- Parts A, B, C -->
          <div class="space-y-3">
            {
              q.parts.map((part) => (
                <div class="p-4 rounded-lg border border-neutral-200 bg-neutral-50/50 hover:bg-white hover:border-neutral-300 transition-colors duration-150">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex-1">
                      <span class="inline-block px-2 py-0.5 text-[10px] font-bold rounded bg-neutral-200 text-neutral-800 mr-1.5">
                        Part {part.part}
                      </span>
                      <span class="text-xs font-bold text-neutral-900">{part.promptTemplate}</span>
                      <p class="text-[11px] text-neutral-600 mt-1 leading-snug">{part.scoringCriteria}</p>
                      <p class="text-[10px] text-neutral-500 font-medium mt-1.5"><strong class="text-neutral-700">Tip:</strong> {part.tips}</p>
                    </div>

                    <!-- Point toggle (0 or 1) -->
                    <div class="flex items-center gap-1.5 shrink-0 pt-0.5">
                      <label class="inline-flex items-center gap-1.5 text-xs font-semibold cursor-pointer p-1 rounded-lg hover:bg-neutral-100 transition-colors">
                        <input
                          type="checkbox"
                          data-part-id={part.id}
                          data-q-parent={q.id}
                          checked
                          class="w-5 h-5 rounded text-blue-700 accent-blue-700 saq-part-checkbox cursor-pointer transition-transform active:scale-90"
                        />
                        <span class="text-xs font-extrabold text-neutral-800 tabular-nums">1 pt</span>
                      </label>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  let prevTotal: number | null = null;
  function updateSaqScores() {
    const checkboxes = document.querySelectorAll('.saq-part-checkbox') as NodeListOf<HTMLInputElement>;
    let total = 0;
    const qTotals: Record<string, number> = {};

    checkboxes.forEach((cb) => {
      const qId = cb.getAttribute('data-q-parent') || '';
      if (!qTotals[qId]) qTotals[qId] = 0;
      if (cb.checked) {
        total += 1;
        qTotals[qId] += 1;
      }
    });

    const scoreDisplay = document.getElementById('saq-total-score');
    const compositeDisplay = document.getElementById('saq-composite-points');
    const applyLink = document.getElementById('apply-saq-to-main') as HTMLAnchorElement;

    if (scoreDisplay) {
      scoreDisplay.textContent = total.toString();
      if (prevTotal !== null && prevTotal !== total) {
        scoreDisplay.classList.remove('animate-score-pop');
        void scoreDisplay.offsetWidth;
        scoreDisplay.classList.add('animate-score-pop');
      }
    }
    prevTotal = total;
    if (compositeDisplay) compositeDisplay.textContent = ((total / 9) * 20).toFixed(2);
    if (applyLink) applyLink.href = `/apush-score-calculator/?saq=${total}`;

    // Update individual question totals
    document.querySelectorAll('.q-score-sum').forEach((el) => {
      const qId = el.getAttribute('data-q-id');
      if (qId && qTotals[qId] !== undefined) {
        el.textContent = qTotals[qId].toString();
      }
    });
  }

  function setupSaq() {
    document.querySelectorAll('.saq-part-checkbox').forEach((cb) => {
      cb.addEventListener('change', updateSaqScores);
    });
    updateSaqScores();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSaq);
  } else {
    setupSaq();
  }
</script>
