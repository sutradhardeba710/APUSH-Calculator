---
---

<div class="mt-6 p-4 rounded-xl bg-white border border-neutral-200/90 shadow-xs">
  <div class="flex items-center justify-between mb-2">
    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-600">AP Score Cutoff Spectrum</h3>
    <span class="text-[11px] font-medium text-neutral-500">Passing: 3, 4, 5</span>
  </div>

  <!-- Spectrum Bar with Score Segments -->
  <div class="relative pt-6 pb-2">
    <!-- Moving composite marker pin -->
    <div
      id="scale-marker-pin"
      class="absolute top-0 -translate-x-1/2 transition-all duration-300 flex flex-col items-center pointer-events-none z-10"
      style="left: 69.5%;"
    >
      <span
        id="scale-marker-label"
        class="px-2 py-0.5 rounded text-[10px] font-bold bg-neutral-900 text-white shadow-sm whitespace-nowrap"
      >
        69.5
      </span>
      <div class="w-0 h-0 border-l-[4px] border-l-transparent border-r-[4px] border-r-transparent border-t-[5px] border-t-neutral-900"></div>
    </div>

    <!-- The 5 Colored Bands -->
    <div class="grid grid-cols-12 h-3.5 rounded-full overflow-hidden bg-neutral-100 border border-neutral-200">
      <!-- 1: 0 - 34 (35%) -> col-span-4 -->
      <div class="col-span-4 bg-rose-200 border-r border-white/50" title="Score 1 (0–34)"></div>
      <!-- 2: 35 - 46 (12%) -> col-span-2 -->
      <div class="col-span-2 bg-amber-200 border-r border-white/50" title="Score 2 (35–46)"></div>
      <!-- 3: 47 - 59 (13%) -> col-span-2 -->
      <div class="col-span-2 bg-sky-200 border-r border-white/50" title="Score 3 (47–59)"></div>
      <!-- 4: 60 - 73 (14%) -> col-span-2 -->
      <div class="col-span-2 bg-emerald-200 border-r border-white/50" title="Score 4 (60–73)"></div>
      <!-- 5: 74 - 100 (26%) -> col-span-2 -->
      <div class="col-span-2 bg-emerald-400" title="Score 5 (74–100)"></div>
    </div>

    <!-- Cutoff ticks & labels -->
    <div class="flex justify-between items-center text-[10px] font-semibold text-neutral-500 mt-2 px-1">
      <div class="text-left"><span class="block text-rose-700">1</span>0</div>
      <div class="text-center"><span class="block text-amber-700">2</span>35</div>
      <div class="text-center"><span class="block text-sky-700 font-bold">3 ★</span>47</div>
      <div class="text-center"><span class="block text-emerald-700">4</span>60</div>
      <div class="text-center"><span class="block text-emerald-800 font-bold">5</span>74</div>
      <div class="text-right"><span class="block text-neutral-400">Max</span>100</div>
    </div>
  </div>
</div>
