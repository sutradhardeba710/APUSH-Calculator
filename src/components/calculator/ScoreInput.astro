---
interface Props {
  id: 'mcq' | 'saq' | 'dbq' | 'leq';
  label: string;
  shortName: string;
  max: number;
  weightPercent: number;
  defaultValue?: number;
  description: string;
  rubricLink?: string;
}

const {
  id,
  label,
  shortName,
  max,
  weightPercent,
  defaultValue = 0,
  description,
  rubricLink,
} = Astro.props;

const inputId = `score-input-${id}`;
const sliderId = `score-slider-${id}`;
const errorId = `score-error-${id}`;
const hintId = `score-hint-${id}`;
---

<div class="score-input-card p-4 sm:p-5 rounded-xl bg-white border border-neutral-200/90 shadow-xs hover:border-neutral-300 transition-all">
  <!-- Header row -->
  <div class="flex items-start justify-between gap-2 mb-2">
    <div>
      <div class="flex items-center gap-2">
        <label for={inputId} class="font-heading font-bold text-base text-neutral-900 cursor-pointer">
          {label}
        </label>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-100">
          {weightPercent}% of Exam
        </span>
      </div>
      <p id={hintId} class="text-xs text-neutral-500 mt-0.5">
        {description}
        {rubricLink && (
          <a href={rubricLink} class="text-blue-600 hover:text-blue-800 underline ml-1">
            Rubric guide →
          </a>
        )}
      </p>
    </div>

    <!-- Stepper & Input group -->
    <div class="flex items-center gap-1 shrink-0">
      <button
        type="button"
        class="step-btn step-down w-8 h-8 rounded-lg bg-neutral-100 hover:bg-neutral-200 active:bg-neutral-300 text-neutral-700 font-bold flex items-center justify-center transition-colors focus-visible:outline-2 focus-visible:outline-blue-600"
        data-target={inputId}
        aria-label={`Decrease ${shortName} score`}
      >
        −
      </button>

      <div class="relative flex items-center">
        <input
          type="number"
          id={inputId}
          name={id}
          min="0"
          max={max}
          value={defaultValue}
          inputmode="numeric"
          pattern="[0-9]*"
          class="score-number-input w-16 h-10 text-center font-heading font-bold text-lg text-neutral-900 bg-neutral-50 border border-neutral-300 rounded-lg focus:bg-white focus:border-blue-600 focus:ring-2 focus:ring-blue-100 transition-all outline-none"
          aria-describedby={`${hintId} ${errorId}`}
          aria-invalid="false"
        />
      </div>

      <button
        type="button"
        class="step-btn step-up w-8 h-8 rounded-lg bg-neutral-100 hover:bg-neutral-200 active:bg-neutral-300 text-neutral-700 font-bold flex items-center justify-center transition-colors focus-visible:outline-2 focus-visible:outline-blue-600"
        data-target={inputId}
        aria-label={`Increase ${shortName} score`}
      >
        +
      </button>
    </div>
  </div>

  <!-- Range Slider & Max label -->
  <div class="mt-3 pt-2 border-t border-neutral-100 flex items-center gap-3">
    <input
      type="range"
      id={sliderId}
      min="0"
      max={max}
      value={defaultValue}
      class="score-range-slider flex-1 h-2 bg-neutral-200 rounded-lg appearance-none cursor-pointer accent-blue-700"
      aria-label={`${shortName} score slider`}
    />
    <span class="text-xs font-semibold text-neutral-500 w-12 text-right">
      <span class="current-val text-neutral-900 font-bold">{defaultValue}</span> / {max}
    </span>
  </div>

  <!-- Inline Error Notification -->
  <p id={errorId} class="text-xs text-rose-600 font-medium mt-1.5 hidden" role="alert"></p>
</div>
