---
import Layout from '../../layouts/Layout.astro';
import Header from '../common/Header.astro';
import Footer from '../common/Footer.astro';
import Breadcrumb from '../common/Breadcrumb.astro';
import DisclaimerCard from '../common/DisclaimerCard.astro';
import OtherCalculators from '../common/OtherCalculators.astro';
import FAQ from '../faq/FAQ.astro';
import UnifiedSubjectCalculator from './UnifiedSubjectCalculator.astro';
import ScoreDistributionTable from './ScoreDistributionTable.astro';
import type { SubjectExamConfig } from '../../data/exam-config/subject-types';
import { getSubjectContent } from '../../data/subject-content';

interface Props {
  config: SubjectExamConfig;
  canonicalUrl?: string;
}

const { config, canonicalUrl = `https://apushcalculator.com/${config.slug}/` } = Astro.props;
const content = getSubjectContent(config.id);

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${config.name} Score Calculator`,
  url: canonicalUrl,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: config.metaDescription,
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
};
---

<Layout
  title={config.metaTitle}
  description={config.metaDescription}
  canonicalUrl={canonicalUrl}
>
  <Header slot="header" activePath={`/${config.slug}/`} />

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-12">
    <!-- Breadcrumb: Home > AP Score Calculators > Subject Calculator -->
    <Breadcrumb
      items={[
        { label: 'AP Score Calculators', href: '/ap-score-calculators/' },
        { label: `${config.abbreviation} Score Calculator` },
      ]}
    />

    <!-- Subject Hero Header -->
    <div class="space-y-3 max-w-4xl">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
        {config.heroBadge}
      </span>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-neutral-900 tracking-tight leading-tight">
        {config.h1}
      </h1>

      <p class="text-base sm:text-lg text-neutral-600 leading-relaxed max-w-3xl">
        {config.shortDescription}
      </p>
    </div>

    <!-- Official Scoring Notice / Trust Disclaimer -->
    <DisclaimerCard />

    <!-- Master Unified Interactive Calculator -->
    <UnifiedSubjectCalculator config={config} />

    <!-- How This Exam Is Scored Methodology Section -->
    <section class="reveal-on-scroll p-8 sm:p-10 rounded-2xl bg-white border border-neutral-200 space-y-8">
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-neutral-900">
          {content.howItWorks.title}
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 mt-2 leading-relaxed">
          {content.howItWorks.summary}
        </p>
      </div>

      <!-- Step Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          content.howItWorks.steps.map((st) => (
            <div class="p-5 rounded-xl bg-neutral-50 border border-neutral-200 space-y-2">
              <div class="w-8 h-8 rounded-lg bg-blue-700 text-white font-black text-xs flex items-center justify-center">
                {st.step}
              </div>
              <h3 class="text-sm font-bold font-heading text-neutral-900">
                {st.title}
              </h3>
              <p class="text-xs text-neutral-600 leading-relaxed">
                {st.explanation}
              </p>
            </div>
          ))
        }
      </div>

      <!-- College Board Reader Insights -->
      <div class="p-5 rounded-xl bg-neutral-50 border border-neutral-200 text-xs sm:text-sm text-neutral-700 space-y-1.5">
        <span class="font-bold text-neutral-900 block">
          AP Reader & Equating Standards:
        </span>
        <p class="leading-relaxed">
          {content.howItWorks.gradingInsights}
        </p>
      </div>
    </section>

    <!-- Section Breakdown & Strategy Guide -->
    <section class="reveal-on-scroll space-y-6">
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-neutral-900">
          {config.name} Exam Section Breakdown & Strategy
        </h2>
        <p class="text-sm text-neutral-600 mt-1">
          Detailed time limits, question counts, and high-impact test-taking strategies for each section.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          content.sectionGuide.map((sg) => (
            <div class="p-6 rounded-xl bg-white border border-neutral-200 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-base font-bold font-heading text-neutral-900">
                  {sg.title}
                </h3>
                <span class="text-[11px] font-semibold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded border border-blue-100">
                  {sg.shortName}
                </span>
              </div>
              <p class="text-xs text-neutral-600 leading-relaxed">
                {sg.details}
              </p>
              <div class="p-3 rounded-lg bg-neutral-50 border border-neutral-200 text-xs text-neutral-700 space-y-1">
                <span class="font-bold text-neutral-900 block text-[11px] uppercase tracking-wider">
                  Proven Strategy:
                </span>
                <p class="leading-relaxed">{sg.strategy}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Score Benchmarks & College Credit Reference -->
    <section class="reveal-on-scroll p-8 rounded-2xl bg-white border border-neutral-200 space-y-6">
      <div>
        <h2 class="text-2xl font-extrabold font-heading text-neutral-900">
          What Your Estimated {config.abbreviation} Score Means
        </h2>
        <p class="text-sm text-neutral-500 mt-1">
          How universities translate AP score tiers into credit, course waivers, and academic standing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        {
          content.scoreBenchmarks.map((bm) => {
            const badgeColorMap: Record<number, string> = {
              5: 'bg-emerald-50 text-emerald-800 border-emerald-200',
              4: 'bg-blue-50 text-blue-800 border-blue-200',
              3: 'bg-sky-50 text-sky-800 border-sky-200',
              2: 'bg-amber-50 text-amber-800 border-amber-200',
              1: 'bg-rose-50 text-rose-800 border-rose-200',
            };
            return (
              <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-200 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-2xl font-black font-heading text-neutral-900">{bm.score}</span>
                  <span class={`text-[10px] font-semibold px-2 py-0.5 rounded border ${badgeColorMap[bm.score]}`}>
                    {bm.cutoffDescription}
                  </span>
                </div>
                <h3 class="text-xs font-bold text-neutral-900">{bm.title}</h3>
                <p class="text-[11px] text-neutral-600 leading-relaxed">{bm.academicValue}</p>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Official 5-Year Historical Score Distribution Visualizer -->
    <ScoreDistributionTable
      distributions={config.historicalDistributions}
      subjectName={config.name}
    />

    <!-- Subject Specific Supporting Tools (if any) -->
    {
      content.relatedTools && content.relatedTools.length > 0 && (
        <section class="reveal-on-scroll p-8 rounded-2xl bg-neutral-50 border border-neutral-200 space-y-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold font-heading text-neutral-900">
              Related {config.abbreviation} Study & Scoring Tools
            </h2>
            <p class="text-xs sm:text-sm text-neutral-500 mt-1">
              Explore specialized rubric calculators and curve predictors designed for {config.abbreviation}.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {content.relatedTools.map((tool) => (
              <a
                href={tool.url}
                class="interactive-card group p-5 rounded-xl bg-white border border-neutral-200 hover:border-blue-400 space-y-2"
              >
                <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">
                  {tool.badge}
                </span>
                <h3 class="text-sm font-bold font-heading text-neutral-900 group-hover:text-blue-700 transition-colors">
                  {tool.title}
                </h3>
                <p class="text-xs text-neutral-500 leading-relaxed">{tool.description}</p>
                <div class="text-xs font-bold text-blue-700 pt-1 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                  Launch Tool →
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Cross-Subject Internal Linking Section -->
    <OtherCalculators
      currentSlug={config.slug}
      title="Explore Other AP® Score Calculators"
      subtitle={`Compare your ${config.abbreviation} performance with calculators for other Advanced Placement subjects.`}
    />

    <!-- Frequently Asked Questions Accordion with Schema -->
    <FAQ items={content.faqs} />

    <!-- Official Sources & Verification Section -->
    <section class="reveal-on-scroll p-6 rounded-2xl bg-neutral-50 border border-neutral-200 text-xs text-neutral-600 space-y-3">
      <h2 class="font-bold font-heading text-neutral-900 uppercase tracking-wider text-[11px]">
        Official College Board Verification & Sources
      </h2>
      <p class="leading-relaxed">
        The weighting rules, question counts, and scoring distributions on this page are calibrated directly from official College Board publications:
      </p>
      <ul class="space-y-1.5 pl-4 list-disc text-neutral-500">
        {
          config.sources.map((src) => (
            <li>
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-700 hover:underline font-semibold"
              >
                {src.title} ({src.publisher}{src.year ? `, ${src.year}` : ''})
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-[11px] text-neutral-400 pt-1">
        This independent educational utility is maintained for student practice analysis and is not sponsored by or affiliated with the College Board.
      </p>
    </section>
  </div>

  <Footer slot="footer" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
</Layout>
