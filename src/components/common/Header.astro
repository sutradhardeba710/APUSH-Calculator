---
interface Props {
  activePath?: string;
}

const { activePath = '' } = Astro.props;

const navLinks = [
  { href: '/apush-score-calculator/', label: 'Calculator', description: 'Full exam score calculator' },
  { href: '/apush-score-predictor/', label: 'Predictor', description: 'Score probabilities & ranges' },
  { href: '/apush-dbq-score-calculator/', label: 'DBQ', description: '7-point rubric calculator' },
  { href: '/apush-leq-score-calculator/', label: 'LEQ', description: '6-point rubric calculator' },
  { href: '/apush-saq-score-calculator/', label: 'SAQ', description: '9-point short answer calculator' },
  { href: '/apush-score-distribution/', label: 'Distributions', description: 'Historical curves & pass rates' },
];
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur border-b border-neutral-200/80 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2.5 font-heading text-lg font-bold text-neutral-900 hover:text-blue-700 transition-colors focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 rounded-md"
        aria-label="APUSH Score Calculator Home"
      >
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-700 text-white font-black text-sm tracking-wider shadow-sm">
          AP
        </span>
        <span class="flex flex-col">
          <span class="leading-tight text-neutral-900 font-extrabold">APUSH Calculator</span>
          <span class="text-[10px] text-neutral-500 font-medium tracking-wide uppercase">Score & Curve Estimator</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1" aria-label="Main Navigation">
        {
          navLinks.map((link) => {
            const isActive = activePath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${
                  isActive
                    ? 'bg-blue-50 text-blue-700 font-semibold shadow-xs'
                    : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100'
                }`}
                aria-current={isActive ? 'page' : undefined}
                title={link.description}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right Action / Mobile menu button -->
      <div class="flex items-center gap-2">
        <a
          href="/apush-score-calculator/"
          class="hidden sm:inline-flex items-center justify-center px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-lg shadow-sm transition-all focus-visible:outline-2 focus-visible:outline-blue-600"
        >
          Calculate Score
        </a>

        <!-- Mobile menu toggle -->
        <button
          type="button"
          id="mobile-menu-button"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-600"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-200 bg-white px-4 pt-2 pb-4 shadow-lg space-y-1">
    {
      navLinks.map((link) => {
        const isActive = activePath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium ${
              isActive
                ? 'bg-blue-50 text-blue-700 font-semibold'
                : 'text-neutral-700 hover:bg-neutral-100'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            <div class="flex flex-col">
              <span>{link.label}</span>
              <span class="text-xs text-neutral-500 font-normal">{link.description}</span>
            </div>
          </a>
        );
      })
    }
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu && hamburgerIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
