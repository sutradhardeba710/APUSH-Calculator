---
interface Props {
  activePath?: string;
}

const { activePath = '' } = Astro.props;

const mainNavLinks = [
  { href: '/ap-score-calculators/', label: 'All Calculators', badge: 'Hub' },
  { href: '/apush-score-calculator/', label: 'APUSH' },
  { href: '/ap-lang-score-calculator/', label: 'AP Lang' },
  { href: '/ap-biology-score-calculator/', label: 'AP Bio' },
  { href: '/ap-calculus-ab-score-calculator/', label: 'Calc AB' },
  { href: '/ap-calculus-bc-score-calculator/', label: 'Calc BC' },
  { href: '/ap-psychology-score-calculator/', label: 'Psych' },
  { href: '/ap-chemistry-score-calculator/', label: 'Chem' },
  { href: '/ap-csp-score-calculator/', label: 'CSP' },
];
---

<header id="site-header" class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-neutral-200/80 transition-all duration-200">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="/"
        class="group flex items-center gap-2.5 font-heading text-lg font-bold text-neutral-900 hover:text-blue-700 transition-colors focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 rounded-lg p-1 -m-1"
        aria-label="AP Score Calculator Hub Home"
      >
        <img
          src="/favicon.svg"
          alt="AP Score Hub Logo"
          width="36"
          height="36"
          class="w-9 h-9 rounded-lg shadow-xs group-hover:scale-105 transition-transform duration-200"
        />
        <span class="flex flex-col">
          <span class="leading-tight text-neutral-900 font-extrabold text-base sm:text-lg group-hover:text-blue-700 transition-colors">AP Score Hub</span>
          <span class="text-[10px] text-neutral-500 font-medium tracking-wide uppercase">Score & Curve Estimators</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden xl:flex items-center space-x-1" aria-label="Main Navigation">
        {
          mainNavLinks.map((link) => {
            const isActive = activePath === link.href;
            return (
              <a
                href={link.href}
                class={`px-2.5 py-1.5 text-xs font-semibold rounded-lg transition-all duration-150 active:scale-[0.98] ${
                  isActive
                    ? 'bg-blue-50 text-blue-700 shadow-2xs font-bold border border-blue-100/80'
                    : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right Action / Mobile menu button -->
      <div class="flex items-center gap-2">
        <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-neutral-100 text-neutral-600 border border-neutral-200">
          2026–2027 Updated
        </span>

        <!-- Mobile menu toggle button with animated icon -->
        <button
          type="button"
          id="mobile-menu-button"
          class="xl:hidden inline-flex items-center justify-center p-2 rounded-lg text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 transition-colors active:scale-95"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <div class="w-6 h-6 flex flex-col justify-center items-center gap-1.5 relative">
            <span id="burger-bar-1" class="w-5 h-0.5 bg-neutral-700 rounded-full transition-all duration-250 transform origin-center"></span>
            <span id="burger-bar-2" class="w-5 h-0.5 bg-neutral-700 rounded-full transition-all duration-200"></span>
            <span id="burger-bar-3" class="w-5 h-0.5 bg-neutral-700 rounded-full transition-all duration-250 transform origin-center"></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu dropdown with smooth transition container -->
  <div
    id="mobile-menu"
    class="xl:hidden border-t border-neutral-200/90 bg-white/98 backdrop-blur-lg px-4 pt-2 pb-5 shadow-xl space-y-1 max-h-0 opacity-0 overflow-hidden transition-all duration-250 ease-out"
    aria-hidden="true"
  >
    <div class="text-[11px] font-bold text-neutral-400 uppercase tracking-wider px-3 py-1.5">AP Score Calculators</div>
    <div class="grid grid-cols-2 gap-1 sm:block sm:space-y-1">
      {
        mainNavLinks.map((link) => {
          const isActive = activePath === link.href;
          return (
            <a
              href={link.href}
              class={`block px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 active:scale-[0.98] ${
                isActive
                  ? 'bg-blue-50 text-blue-700 font-bold border border-blue-100'
                  : 'text-neutral-700 hover:bg-neutral-100'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>
    <div class="pt-3 mt-2 border-t border-neutral-100">
      <a
        href="/ap-score-calculators/"
        class="w-full flex items-center justify-center px-4 py-2.5 text-xs font-bold text-white bg-blue-700 hover:bg-blue-800 rounded-lg shadow-sm transition-all"
      >
        View Complete Calculator Directory →
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeaderInteractions() {
    const header = document.getElementById('site-header');
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('burger-bar-1');
    const bar2 = document.getElementById('burger-bar-2');
    const bar3 = document.getElementById('burger-bar-3');

    // Header elevation on scroll
    function handleScroll() {
      if (!header) return;
      if (window.scrollY > 10) {
        header.classList.add('shadow-sm', 'border-neutral-200');
        header.classList.remove('border-neutral-200/80');
      } else {
        header.classList.remove('shadow-sm');
        header.classList.add('border-neutral-200/80');
      }
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile menu toggle
    if (!button || !menu || !bar1 || !bar2 || !bar3) return;

    function openMenu() {
      button?.setAttribute('aria-expanded', 'true');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.classList.remove('max-h-0', 'opacity-0');
      menu?.classList.add('max-h-[85vh]', 'opacity-100', 'overflow-y-auto');

      // Morph hamburger to X
      bar1?.classList.add('translate-y-2', 'rotate-45');
      bar2?.classList.add('opacity-0', 'scale-x-0');
      bar3?.classList.add('-translate-y-2', '-rotate-45');
    }

    function closeMenu() {
      button?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.classList.add('max-h-0', 'opacity-0');
      menu?.classList.remove('max-h-[85vh]', 'opacity-100', 'overflow-y-auto');

      // Morph X to hamburger
      bar1?.classList.remove('translate-y-2', 'rotate-45');
      bar2?.classList.remove('opacity-0', 'scale-x-0');
      bar3?.classList.remove('-translate-y-2', '-rotate-45');
    }

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (button.getAttribute('aria-expanded') === 'true' && target && !menu.contains(target) && !button.contains(target)) {
        closeMenu();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        button.focus();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderInteractions);
  } else {
    setupHeaderInteractions();
  }
</script>
