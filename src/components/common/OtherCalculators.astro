---
import { ALL_SUBJECTS } from '../../data/exam-config/subjects-registry';

interface Props {
  currentSlug?: string;
  title?: string;
  subtitle?: string;
}

const {
  currentSlug = '',
  title = 'Explore Other AP® Score Calculators',
  subtitle = 'Estimate your scores and analyze score distributions across other Advanced Placement exams.',
} = Astro.props;

// Filter out the current subject if on a subject page, or show all on hub
const subjectsToDisplay = ALL_SUBJECTS.filter((sub) => sub.slug !== currentSlug);

const categoryIcons: Record<string, string> = {
  'History & Social Sciences': 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  'Sciences': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'Math & Computer Science': 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  'English': 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
};
---

<section class="reveal-on-scroll my-16">
  <div class="max-w-3xl mx-auto text-center mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-2">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
      Multi-Subject Calculator Network
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-neutral-900 tracking-tight">
      {title}
    </h2>
    <p class="text-sm sm:text-base text-neutral-600 mt-2">
      {subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
    {
      subjectsToDisplay.map((sub) => {
        const iconPath = categoryIcons[sub.category] || categoryIcons['Sciences'];
        return (
          <a
            href={`/${sub.slug}/`}
            class="group p-5 rounded-2xl bg-white border border-neutral-200 hover:border-blue-400 shadow-2xs interactive-card active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-700 group-hover:bg-blue-700 group-hover:text-white transition-colors duration-200 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath}></path>
                  </svg>
                </span>
                <span class="text-[11px] font-bold text-neutral-600 bg-neutral-100 px-2 py-0.5 rounded-md">
                  {sub.abbreviation}
                </span>
              </div>

              <h3 class="text-base font-bold font-heading text-neutral-900 group-hover:text-blue-700 transition-colors duration-200">
                {sub.name}
              </h3>
              <p class="text-xs text-neutral-500 mt-1.5 line-clamp-2 leading-relaxed">
                {sub.shortDescription}
              </p>
            </div>

            <div class="pt-4 mt-3 border-t border-neutral-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-neutral-400 group-hover:text-neutral-600 transition-colors duration-200">
                {sub.category}
              </span>
              <span class="text-xs font-bold text-blue-700 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform duration-200">
                Calculate Score →
              </span>
            </div>
          </a>
        );
      })
    }
  </div>

  <div class="mt-8 text-center">
    <a
      href="/ap-score-calculators/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-neutral-700 bg-neutral-100 hover:bg-neutral-200 active:scale-95 transition-all duration-200"
    >
      View All 8 AP Score Calculators on the Central Hub →
    </a>
  </div>
</section>
