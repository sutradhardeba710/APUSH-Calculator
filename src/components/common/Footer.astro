---
import { ALL_SUBJECTS } from '../../data/exam-config/subjects-registry';
import ThemeToggle from './ThemeToggle.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-[#070b12] border-t border-neutral-200 dark:border-neutral-800/80 mt-20 pt-12 pb-8 text-neutral-600 dark:text-neutral-400 transition-colors duration-200">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Col 1: Brand & Mission -->
      <div class="space-y-3">
        <a href="/" class="flex items-center gap-2.5 font-heading text-lg font-bold text-neutral-900 dark:text-white">
          <img
            src="/favicon.svg"
            alt="AP Score Hub Logo"
            width="32"
            height="32"
            class="w-8 h-8 rounded-lg"
          />
          <span>AP Score Hub</span>
        </a>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
          Independent educational AP score calculators and curve estimators based on official College Board exam weightings, Course and Exam Descriptions (CED), and historical equating models.
        </p>
        <div class="pt-2 flex items-center gap-2 text-xs text-emerald-700 dark:text-emerald-400 font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          Updated for 2026–2027 Guidelines
        </div>
      </div>

      <!-- Col 2: AP Calculators (Part 1) -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white">AP Score Calculators</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/ap-score-calculators/" class={`transition-colors ${Astro.url.pathname === '/ap-score-calculators/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>All AP Calculators Hub</a>
          </li>
          <li>
            <a href="/apush-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/apush-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP U.S. History (APUSH)</a>
          </li>
          <li>
            <a href="/ap-lang-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-lang-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP English Language</a>
          </li>
          <li>
            <a href="/ap-biology-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-biology-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP Biology</a>
          </li>
          <li>
            <a href="/ap-calculus-ab-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-calculus-ab-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP Calculus AB</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: AP Calculators (Part 2) -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white">STEM & Social Sciences</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/ap-calculus-bc-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-calculus-bc-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP Calculus BC</a>
          </li>
          <li>
            <a href="/ap-psychology-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-psychology-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP Psychology</a>
          </li>
          <li>
            <a href="/ap-chemistry-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-chemistry-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP Chemistry</a>
          </li>
          <li>
            <a href="/ap-csp-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/ap-csp-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>AP Computer Science Principles</a>
          </li>
        </ul>
      </div>

      <!-- Col 4: APUSH Topic Cluster -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white">APUSH Deep-Dive Tools</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/apush-dbq-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/apush-dbq-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>DBQ Rubric Calculator (7 Pts)</a>
          </li>
          <li>
            <a href="/apush-leq-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/apush-leq-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>LEQ Rubric Calculator (6 Pts)</a>
          </li>
          <li>
            <a href="/apush-saq-score-calculator/" class={`transition-colors ${Astro.url.pathname === '/apush-saq-score-calculator/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>SAQ Scoring Calculator (9 Pts)</a>
          </li>
          <li>
            <a href="/apush-score-predictor/" class={`transition-colors ${Astro.url.pathname === '/apush-score-predictor/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>Score Predictor & Curves</a>
          </li>
          <li>
            <a href="/apush-score-distribution/" class={`transition-colors ${Astro.url.pathname === '/apush-score-distribution/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>Historical Distributions</a>
          </li>
        </ul>
      </div>

      <!-- Col 5: Support & Legal -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white">Support & Legal</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/support/" class={`transition-colors flex items-center gap-1.5 ${Astro.url.pathname === '/support/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>
              <span>Support &amp; Help Desk</span>
            </a>
          </li>
          <li>
            <a href="/privacy-policy/" class={`transition-colors ${Astro.url.pathname === '/privacy-policy/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>Privacy Policy</a>
          </li>
          <li>
            <a href="/terms-of-service/" class={`transition-colors ${Astro.url.pathname === '/terms-of-service/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>Terms of Service</a>
          </li>
          <li>
            <a href="/dmca/" class={`transition-colors ${Astro.url.pathname === '/dmca/' ? 'font-bold text-blue-700 dark:text-blue-400 hover:underline' : 'hover:text-blue-700 dark:hover:text-blue-400'}`}>DMCA &amp; Copyright</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- College Board Disclaimer & Bottom Bar -->
    <div class="border-t border-neutral-200 dark:border-neutral-800/80 pt-6 text-[11px] text-neutral-400 dark:text-neutral-500 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="max-w-2xl leading-relaxed text-center md:text-left">
        <strong>Notice:</strong> AP® and Advanced Placement® are registered trademarks of the College Board, which is not affiliated with, does not endorse, and was not involved in the production of this educational website. Score conversions are independent statistical estimates.
      </p>
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-3 gap-y-2 shrink-0 text-neutral-500 dark:text-neutral-400">
        <ThemeToggle id="footer-theme-toggle" />
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <a href="/support/" class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors">Support</a>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <a href="/privacy-policy/" class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors">Privacy</a>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <a href="/terms-of-service/" class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors">Terms</a>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <a href="/dmca/" class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors">DMCA</a>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <span>© {currentYear} AP Score Hub.</span>
      </div>
    </div>
  </div>
</footer>
