---
import { ALL_SUBJECTS } from '../../data/exam-config/subjects-registry';

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-neutral-200 mt-20 pt-12 pb-8 text-neutral-600">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Col 1: Brand & Mission -->
      <div class="lg:col-span-2 space-y-3">
        <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold text-neutral-900">
          <span class="flex items-center justify-center w-7 h-7 rounded-md bg-blue-700 text-white font-black text-xs">
            AP
          </span>
          <span>AP Score Hub</span>
        </a>
        <p class="text-xs text-neutral-500 leading-relaxed max-w-sm">
          Independent educational AP score calculators and curve estimators based on official College Board exam weightings, Course and Exam Descriptions (CED), and historical equating models.
        </p>
        <div class="pt-2 flex items-center gap-2 text-xs text-emerald-700 font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          Updated for 2026–2027 College Board Guidelines
        </div>
      </div>

      <!-- Col 2: AP Calculators (Part 1) -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">AP Score Calculators</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/ap-score-calculators/" class="font-bold text-blue-700 hover:underline">All AP Calculators Hub</a>
          </li>
          <li>
            <a href="/apush-score-calculator/" class="hover:text-blue-700 transition-colors">AP U.S. History (APUSH)</a>
          </li>
          <li>
            <a href="/ap-lang-score-calculator/" class="hover:text-blue-700 transition-colors">AP English Language</a>
          </li>
          <li>
            <a href="/ap-biology-score-calculator/" class="hover:text-blue-700 transition-colors">AP Biology</a>
          </li>
          <li>
            <a href="/ap-calculus-ab-score-calculator/" class="hover:text-blue-700 transition-colors">AP Calculus AB</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: AP Calculators (Part 2) -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">STEM & Social Sciences</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/ap-calculus-bc-score-calculator/" class="hover:text-blue-700 transition-colors">AP Calculus BC</a>
          </li>
          <li>
            <a href="/ap-psychology-score-calculator/" class="hover:text-blue-700 transition-colors">AP Psychology</a>
          </li>
          <li>
            <a href="/ap-chemistry-score-calculator/" class="hover:text-blue-700 transition-colors">AP Chemistry</a>
          </li>
          <li>
            <a href="/ap-csp-score-calculator/" class="hover:text-blue-700 transition-colors">AP Computer Science Principles</a>
          </li>
        </ul>
      </div>

      <!-- Col 4: APUSH Topic Cluster -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">APUSH Deep-Dive Tools</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/apush-dbq-score-calculator/" class="hover:text-blue-700 transition-colors">DBQ Rubric Calculator (7 Pts)</a>
          </li>
          <li>
            <a href="/apush-leq-score-calculator/" class="hover:text-blue-700 transition-colors">LEQ Rubric Calculator (6 Pts)</a>
          </li>
          <li>
            <a href="/apush-saq-score-calculator/" class="hover:text-blue-700 transition-colors">SAQ Scoring Calculator (9 Pts)</a>
          </li>
          <li>
            <a href="/apush-score-predictor/" class="hover:text-blue-700 transition-colors">Score Predictor & Curves</a>
          </li>
          <li>
            <a href="/apush-score-distribution/" class="hover:text-blue-700 transition-colors">Historical Distributions</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- College Board Disclaimer & Bottom Bar -->
    <div class="border-t border-neutral-200 pt-6 text-[11px] text-neutral-400 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="max-w-3xl leading-relaxed text-center md:text-left">
        <strong>Notice:</strong> AP® and Advanced Placement® are registered trademarks of the College Board, which is not affiliated with, does not endorse, and was not involved in the production of this educational website. Score conversions are independent statistical estimates.
      </p>
      <div class="flex items-center gap-4 shrink-0">
        <span>© {currentYear} AP Score Hub. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
