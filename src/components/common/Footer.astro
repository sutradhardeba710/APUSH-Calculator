---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-neutral-200 mt-20 pt-12 pb-8 text-neutral-600">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Mission -->
      <div class="md:col-span-1 space-y-3">
        <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold text-neutral-900">
          <span class="flex items-center justify-center w-7 h-7 rounded-md bg-blue-700 text-white font-black text-xs">
            AP
          </span>
          <span>APUSH Calculator</span>
        </a>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Independent AP U.S. History score simulation tool built on official College Board weighting rubrics and historical equating models.
        </p>
        <div class="pt-2 flex items-center gap-2 text-xs text-emerald-700 font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          Updated for 2026–2027 Exam Guidelines
        </div>
      </div>

      <!-- Col 2: Calculators -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">Calculators</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/apush-score-calculator/" class="hover:text-blue-700 transition-colors">Composite APUSH Calculator</a>
          </li>
          <li>
            <a href="/apush-score-predictor/" class="hover:text-blue-700 transition-colors">Score Predictor & Probabilities</a>
          </li>
          <li>
            <a href="/apush-dbq-score-calculator/" class="hover:text-blue-700 transition-colors">DBQ Rubric Calculator (7 Pts)</a>
          </li>
          <li>
            <a href="/apush-leq-score-calculator/" class="hover:text-blue-700 transition-colors">LEQ Rubric Calculator (6 Pts)</a>
          </li>
          <li>
            <a href="/apush-saq-score-calculator/" class="hover:text-blue-700 transition-colors">SAQ Scoring Calculator (9 Pts)</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Exam Insights -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">Exam Insights</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/apush-score-distribution/" class="hover:text-blue-700 transition-colors">Score Distributions & Pass Rates</a>
          </li>
          <li>
            <a href="/apush-score-calculator/#methodology" class="hover:text-blue-700 transition-colors">Scoring Curve Methodology</a>
          </li>
          <li>
            <a href="/apush-score-calculator/#faq" class="hover:text-blue-700 transition-colors">Frequently Asked Questions</a>
          </li>
          <li>
            <a href="/apush-score-calculator/#target-calculator" class="hover:text-blue-700 transition-colors">Target Score Planner</a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Official Disclaimers -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">Notice</h4>
        <p class="text-xs text-neutral-500 leading-relaxed">
          AP® and Advanced Placement® are registered trademarks of the College Board, which was not involved in the production of, and does not endorse, this product.
        </p>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Scores generated by this tool are statistical approximations for self-study and practice exam reflection only.
        </p>
      </div>
    </div>

    <!-- Bottom border & copyright -->
    <div class="pt-8 border-t border-neutral-200/80 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
      <p>© {currentYear} APUSH Score Calculator. Free educational resource for students and educators.</p>
      <div class="flex items-center gap-4">
        <span>Designed for WCAG 2.2 AA Accessibility</span>
      </div>
    </div>
  </div>
</footer>
