---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<aside
  class={`p-4 rounded-xl bg-amber-50/70 border border-amber-200/80 text-amber-900 text-xs flex items-start gap-3 ${className}`}
  role="note"
  aria-label="Official College Board Disclaimer"
>
  <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  <div class="space-y-1">
    <p class="font-semibold text-amber-950">Independent Score Estimation Tool</p>
    <p class="text-amber-800 leading-relaxed">
      This calculator estimates your AP® U.S. History score using the official 40% MCQ, 20% SAQ, 25% DBQ, and 15% LEQ weighting scheme alongside released historical curves. Official score cutoffs vary annually through psychometric equating and are established solely by the College Board.
    </p>
  </div>
</aside>
