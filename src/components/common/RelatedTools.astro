---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const tools = [
  {
    href: '/apush-score-calculator/',
    title: 'Composite Score Calculator',
    description: 'Calculate your full 1–5 AP score with 4-section weighted composite modeling and instant curve analysis.',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
    tag: 'Full Exam',
  },
  {
    href: '/apush-score-predictor/',
    title: 'APUSH Score Predictor',
    description: 'Estimate probabilities for earning a 3, 4, or 5 based on statistical curve variance and practice test ranges.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
    tag: 'Probability',
  },
  {
    href: '/apush-dbq-score-calculator/',
    title: 'DBQ Rubric Calculator',
    description: 'Step-by-step 7-point rubric scorer covering thesis, contextualization, document analysis, and complexity.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    tag: '25% Weight',
  },
  {
    href: '/apush-leq-score-calculator/',
    title: 'LEQ Rubric Scorer',
    description: 'Evaluate your 6-point Long Essay Question performance with contextualization, evidence, and historical reasoning.',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
    tag: '15% Weight',
  },
  {
    href: '/apush-saq-score-calculator/',
    title: 'SAQ Scoring Tool',
    description: 'Score all 3 Short-Answer Questions across parts A, B, and C to identify fast point opportunities.',
    icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
    tag: '20% Weight',
  },
  {
    href: '/apush-score-distribution/',
    title: 'Historical Distributions & Curves',
    description: 'Review national passing rates, percentage of 5s, and official College Board trends from 2021 to 2024.',
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    tag: 'Data',
  },
];

const relatedTools = tools.filter((tool) => !currentPath.startsWith(tool.href));
---

<section class="reveal-on-scroll mt-16">
  <div class="mb-6">
    <h3 class="text-xl font-bold font-heading text-neutral-900">Explore Related APUSH Scoring Tools</h3>
    <p class="text-sm text-neutral-600 mt-1">Specialized calculators and rubrics to analyze every section of your practice test.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      relatedTools.slice(0, 3).map((tool) => (
        <a
          href={tool.href}
          class="group block p-5 rounded-xl bg-white border border-neutral-200/90 shadow-2xs interactive-card active:scale-[0.98] hover:border-blue-300 focus-visible:outline-2 focus-visible:outline-blue-600"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-blue-700 group-hover:bg-blue-700 group-hover:text-white transition-colors duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon}></path>
              </svg>
            </span>
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-700 group-hover:bg-blue-50 group-hover:text-blue-700 transition-colors duration-200">
              {tool.tag}
            </span>
          </div>
          <h4 class="text-base font-bold font-heading text-neutral-900 group-hover:text-blue-700 transition-colors duration-200">
            {tool.title}
          </h4>
          <p class="text-xs text-neutral-600 mt-1.5 leading-relaxed">
            {tool.description}
          </p>
        </a>
      ))
    }
  </div>
</section>
